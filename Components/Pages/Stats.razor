@page "/stats"
@inject IMovieService MovieService

<PageTitle>Archive Stats</PageTitle>

<div class="archive-terminal">

    <div class="archive-header">
        <span>SKYNET ARCHIVE // STATISTICAL ANALYSIS</span>
        <span class="header-status"><span class="status-dot">◉</span> ACTIVE</span>
    </div>

    <div class="archive-body">

        @if (loading)
        {
            <p class="text-muted">// COMPILING DATA…</p>
        }
        else
        {
            <div class="row g-4">

                <!-- Summary strip -->
                <div class="col-12">
                    <div class="stats-summary-strip">
                        <div class="stat-card">
                            <div class="stat-card-label">TOTAL RECORDS</div>
                            <div class="stat-card-value">@totalMovies</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-card-label">CLASSIFIED</div>
                            <div class="stat-card-value">@favoriteMovies</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-card-label">WATCHED</div>
                            <div class="stat-card-value">@(watchStatusCounts.FirstOrDefault(w => w.Status == WatchStatus.Watched).Count)</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-card-label">WANT TO WATCH</div>
                            <div class="stat-card-value">@(watchStatusCounts.FirstOrDefault(w => w.Status == WatchStatus.WantToWatch).Count)</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-card-label">GENRES</div>
                            <div class="stat-card-value">@byGenre.Count</div>
                        </div>
                        <div class="stat-card">
                            <div class="stat-card-label">AVG TMDB RATING</div>
                            <div class="stat-card-value">@avgRating.ToString("F1")</div>
                        </div>
                    </div>
                </div>

                <!-- By genre -->
                <div class="col-md-6">
                    <div class="terminal-panel">
                        <div class="panel-header">CLASSIFICATION BY GENRE</div>
                        <div class="panel-body">
                            @foreach (var (genre, count) in byGenre)
                            {
                                var pct = maxGenreCount > 0 ? (double)count / maxGenreCount * 100 : 0;
                                <div class="bar-row">
                                    <span class="bar-label" title="@genre">@(genre.Length > 18 ? genre[..18] + "…" : genre)</span>
                                    <div class="bar-track">
                                        <div class="bar-fill" style="width:@pct.ToString("F1")%"></div>
                                    </div>
                                    <span class="bar-count">@count</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- By decade -->
                <div class="col-md-6">
                    <div class="terminal-panel">
                        <div class="panel-header">RECORDS BY DECADE</div>
                        <div class="panel-body">
                            @foreach (var (decade, count) in byDecade)
                            {
                                var pct = maxDecadeCount > 0 ? (double)count / maxDecadeCount * 100 : 0;
                                <div class="bar-row">
                                    <span class="bar-label">@decade s</span>
                                    <div class="bar-track">
                                        <div class="bar-fill bar-fill--decade" style="width:@pct.ToString("F1")%"></div>
                                    </div>
                                    <span class="bar-count">@count</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- TMDB rating distribution -->
                <div class="col-md-6">
                    <div class="terminal-panel">
                        <div class="panel-header">TMDB RATING DISTRIBUTION</div>
                        <div class="panel-body">
                            @foreach (var (bucket, count) in byRating)
                            {
                                var pct = maxRatingCount > 0 ? (double)count / maxRatingCount * 100 : 0;
                                <div class="bar-row">
                                    <span class="bar-label">@bucket–@(bucket + 1)</span>
                                    <div class="bar-track">
                                        <div class="bar-fill bar-fill--rating" style="width:@pct.ToString("F1")%"></div>
                                    </div>
                                    <span class="bar-count">@count</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Top directors -->
                <div class="col-md-6">
                    <div class="terminal-panel">
                        <div class="panel-header">TOP ARCHITECTS (DIRECTORS)</div>
                        <div class="panel-body">
                            @foreach (var (director, count) in topDirectors)
                            {
                                var pct = maxDirectorCount > 0 ? (double)count / maxDirectorCount * 100 : 0;
                                <div class="bar-row">
                                    <span class="bar-label" title="@director">@(director.Length > 18 ? director[..18] + "…" : director)</span>
                                    <div class="bar-track">
                                        <div class="bar-fill bar-fill--director" style="width:@pct.ToString("F1")%"></div>
                                    </div>
                                    <span class="bar-count">@count</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Top cast -->
                <div class="col-md-6">
                    <div class="terminal-panel">
                        <div class="panel-header">TOP OPERATIVES (CAST)</div>
                        <div class="panel-body">
                            @foreach (var (actor, count) in topCast)
                            {
                                var pct = maxCastCount > 0 ? (double)count / maxCastCount * 100 : 0;
                                <div class="bar-row">
                                    <span class="bar-label" title="@actor">@(actor.Length > 18 ? actor[..18] + "…" : actor)</span>
                                    <div class="bar-track">
                                        <div class="bar-fill bar-fill--cast" style="width:@pct.ToString("F1")%"></div>
                                    </div>
                                    <span class="bar-count">@count</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

                <!-- Personal rating distribution -->
                <div class="col-md-6">
                    <div class="terminal-panel">
                        <div class="panel-header">PERSONAL RATING DISTRIBUTION</div>
                        <div class="panel-body">
                            @if (byPersonalRating.Count == 0)
                            {
                                <p class="text-muted" style="font-size:0.8rem;">// NO PERSONAL RATINGS RECORDED</p>
                            }
                            else
                            {
                                @foreach (var (stars, count) in byPersonalRating)
                                {
                                    var pct = maxPersonalRatingCount > 0 ? (double)count / maxPersonalRatingCount * 100 : 0;
                                    <div class="bar-row">
                                        <span class="bar-label">@(new string('★', stars))@(new string('☆', 5 - stars))</span>
                                        <div class="bar-track">
                                            <div class="bar-fill bar-fill--rating" style="width:@pct.ToString("F1")%"></div>
                                        </div>
                                        <span class="bar-count">@count</span>
                                    </div>
                                }
                            }
                        </div>
                    </div>
                </div>

                <!-- Runtime stats -->
                <div class="col-md-6">
                    <div class="terminal-panel">
                        <div class="panel-header">RUNTIME ANALYSIS</div>
                        <div class="panel-body">
                            <div class="bar-row">
                                <span class="bar-label">TOTAL LIBRARY</span>
                                <span class="field-dots ms-2 me-2"></span>
                                <span class="bar-count">@FormatRuntime(totalMinutes)</span>
                            </div>
                            <div class="bar-row mt-2">
                                <span class="bar-label">WATCHED</span>
                                <span class="field-dots ms-2 me-2"></span>
                                <span class="bar-count">@FormatRuntime(watchedMinutes)</span>
                            </div>
                            @if (totalMinutes > 0)
                            {
                                var watchedPct = (double)watchedMinutes / totalMinutes * 100;
                                <div class="bar-row mt-2">
                                    <span class="bar-label">COMPLETION</span>
                                    <div class="bar-track ms-2">
                                        <div class="bar-fill bar-fill--decade" style="width:@watchedPct.ToString("F1")%"></div>
                                    </div>
                                    <span class="bar-count">@watchedPct.ToString("F0")%</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>

            </div>

            <!-- Watches by month -->
            @if (watchesByMonth.Count > 0)
            {
                <div class="row g-4 mt-0">
                    <div class="col-12">
                        <div class="terminal-panel">
                            <div class="panel-header">WATCH ACTIVITY BY MONTH</div>
                            <div class="panel-body">
                                <div class="month-chart">
                                    @foreach (var (year, month, count) in watchesByMonth)
                                    {
                                        var pct = maxMonthCount > 0 ? (double)count / maxMonthCount * 100 : 0;
                                        var label = $"{year}-{month:D2}";
                                        <div class="month-col" title="@label: @count watch@(count == 1 ? "" : "es")">
                                            <div class="month-bar-wrap">
                                                <div class="month-bar" style="height:@pct.ToString("F0")%"></div>
                                            </div>
                                            <div class="month-label">@month/@(year % 100)</div>
                                            <div class="month-count">@count</div>
                                        </div>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }

            <div class="mt-3">
                <a href="/movies" class="btn btn-outline-secondary btn-sm">← BACK TO ARCHIVE</a>
            </div>
        }

    </div>
</div>

@code {
    private bool loading = true;

    private int totalMovies;
    private int favoriteMovies;
    private decimal avgRating;
    private int totalMinutes;
    private int watchedMinutes;

    private List<(string Genre, int Count)>        byGenre           = [];
    private List<(int Decade, int Count)>           byDecade          = [];
    private List<(decimal Bucket, int Count)>       byRating          = [];
    private List<(WatchStatus Status, int Count)>   watchStatusCounts = [];
    private List<(string Director, int Count)>      topDirectors      = [];
    private List<(string Actor, int Count)>         topCast           = [];
    private List<(int Stars, int Count)>                byPersonalRating  = [];
    private List<(int Year, int Month, int Count)>      watchesByMonth    = [];

    private int maxGenreCount;
    private int maxDecadeCount;
    private int maxRatingCount;
    private int maxDirectorCount;
    private int maxCastCount;
    private int maxPersonalRatingCount;
    private int maxMonthCount;

    protected override async Task OnInitializedAsync()
    {
        var statsTask         = MovieService.GetStatsAsync();
        var genreTask         = MovieService.GetStatsByGenreAsync();
        var decadeTask        = MovieService.GetStatsByDecadeAsync();
        var ratingTask        = MovieService.GetStatsByRatingBucketAsync();
        var watchTask         = MovieService.GetStatsByWatchStatusAsync();
        var directorTask      = MovieService.GetTopDirectorsAsync(10);
        var castTask          = MovieService.GetTopCastAsync(10);
        var personalRateTask  = MovieService.GetStatsByPersonalRatingAsync();
        var runtimeTask       = MovieService.GetRuntimeStatsAsync();
        var monthTask         = MovieService.GetWatchesByMonthAsync();

        await Task.WhenAll(statsTask, genreTask, decadeTask, ratingTask, watchTask,
            directorTask, castTask, personalRateTask, runtimeTask, monthTask);

        (totalMovies, favoriteMovies) = statsTask.Result;
        byGenre          = genreTask.Result;
        byDecade         = decadeTask.Result;
        byRating         = ratingTask.Result;
        watchStatusCounts = watchTask.Result;
        topDirectors     = directorTask.Result;
        topCast          = castTask.Result;
        byPersonalRating = personalRateTask.Result;
        (totalMinutes, watchedMinutes) = runtimeTask.Result;

        maxGenreCount          = byGenre.Count          > 0 ? byGenre.Max(g => g.Count)          : 0;
        maxDecadeCount         = byDecade.Count         > 0 ? byDecade.Max(g => g.Count)         : 0;
        maxRatingCount         = byRating.Count         > 0 ? byRating.Max(g => g.Count)         : 0;
        maxDirectorCount       = topDirectors.Count     > 0 ? topDirectors.Max(g => g.Count)     : 0;
        maxCastCount           = topCast.Count          > 0 ? topCast.Max(g => g.Count)          : 0;
        maxPersonalRatingCount = byPersonalRating.Count > 0 ? byPersonalRating.Max(g => g.Count) : 0;
        watchesByMonth         = monthTask.Result;
        maxMonthCount          = watchesByMonth.Count  > 0 ? watchesByMonth.Max(g => g.Count)  : 0;

        avgRating = totalMovies > 0
            ? Math.Round(byRating.Sum(b => b.Bucket * b.Count) / totalMovies, 1)
            : 0;

        loading = false;
    }

    private static string FormatRuntime(int minutes)
    {
        var h = minutes / 60;
        var m = minutes % 60;
        return h > 0 ? $"{h}h {m}m" : $"{m}m";
    }
}
