@page "/"

<PageTitle>Skynet Archives</PageTitle>

<div class="hero">
    <div class="hero-label">// SKYNET NETWORK — SECTOR 7 TERMINAL</div>
    <h1 class="hero-title">SKYNET ARCHIVES</h1>
    <p class="hero-sub">Pre-Judgment Day Cinematic Database</p>

    <div class="terminal-block">
        <div class="terminal-line">
            <span class="prompt">SYS:</span>
            <span>Connection established. Terminal online.</span>
        </div>
        <div class="terminal-line">
            <span class="prompt">STATUS:</span>
            <span>Archive integrity verified. All sectors accessible.</span>
        </div>
        <div class="terminal-line">
            <span class="prompt">MISSION:</span>
            <span>Catalogue and analyse human cultural records from the pre-war era.</span>
        </div>
        <div class="terminal-line blink-cursor">
            <span class="prompt">AWAITING INPUT</span>
            <span class="cursor">█</span>
        </div>
    </div>

    <blockquote class="t2-quote">
        "The future is not set. There is no fate but what we make for ourselves."
        <cite>— John Connor</cite>
    </blockquote>

    <div class="hero-actions">
        <a href="/movies" class="btn btn-primary btn-lg">Enter Archive</a>
        <a href="/movies/create" class="btn btn-outline-secondary btn-lg ms-3">Add Record</a>
    </div>
</div>

<div class="stat-strip">
    <div class="stat">
        <span class="stat-label">CLASSIFICATION</span>
        <span class="stat-value">TOP SECRET</span>
    </div>
    <div class="stat">
        <span class="stat-label">NETWORK</span>
        <span class="stat-value">SKYNET v2.0</span>
    </div>
    <div class="stat">
        <span class="stat-label">THREAT LEVEL</span>
        <span class="stat-value">MINIMAL</span>
    </div>
    <div class="stat">
        <span class="stat-label">JUDGMENT DAY</span>
        <span class="stat-value">AUG 29, 1997</span>
    </div>
</div>
