@page "/movies/{Id:int}/edit"
@rendermode InteractiveServer
@inject IMovieQueryService   MovieQuery
@inject IMovieCommandService MovieCommands
@inject NavigationManager    Nav

<PageTitle>Edit Movie</PageTitle>

<div class="archive-terminal">
<div class="archive-header">
    <span>SKYNET ARCHIVE // MODIFY RECORD <span class="record-id">#@Id.ToString("D5")</span></span>
    <span class="header-status"><span class="status-dot">◉</span> EDIT MODE</span>
</div>
<div class="archive-body">

@if (movie is null)
{
    <p class="text-muted">// RECORD NOT FOUND</p>
}
else
{
    <EditForm Model="movie" OnValidSubmit="Save" class="terminal-form">
        <DataAnnotationsValidator />
        <ValidationSummary class="text-danger" />

        <div class="row g-3">
            <div class="col-12">
                <label class="form-label">Title</label>
                <InputText class="form-control" @bind-Value="movie.Title" />
                <ValidationMessage For="() => movie.Title" />
            </div>

            @if (!string.IsNullOrEmpty(movie.PosterUrl))
            {
                <div class="col-12">
                    <img src="@movie.PosterUrl" style="height:150px;border-radius:4px;" alt="Poster" />
                </div>
            }

            <div class="col-12">
                <label class="form-label">Poster URL</label>
                <InputText class="form-control" @bind-Value="movie.PosterUrl" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Release Year</label>
                <InputNumber class="form-control" @bind-Value="movie.ReleaseYear" />
                <ValidationMessage For="() => movie.ReleaseYear" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Genre</label>
                <InputText class="form-control" @bind-Value="movie.Genre" />
            </div>
            <div class="col-md-4">
                <label class="form-label">Rating (0–10)</label>
                <InputNumber class="form-control" @bind-Value="movie.Rating" />
                <ValidationMessage For="() => movie.Rating" />
            </div>

            <div class="col-12">
                <label class="form-label">Director</label>
                <InputText class="form-control" @bind-Value="movie.Director" />
            </div>

            <div class="col-12">
                <label class="form-label">Synopsis</label>
                <InputTextArea class="form-control" @bind-Value="movie.Synopsis" rows="4" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Date Watched</label>
                <input type="date" class="form-control"
                       value="@(movie.DateWatched?.ToString("yyyy-MM-dd") ?? "")"
                       @onchange="OnDateWatchedChange" />
            </div>

            <div class="col-12">
                <label class="form-label">Personal Notes</label>
                <InputTextArea class="form-control" @bind-Value="movie.Notes" rows="4" />
            </div>
        </div>

        <div class="d-flex gap-2 mt-4">
            <button type="submit" class="btn btn-primary">Save</button>
            <a href="/movies/@Id" class="btn btn-outline-secondary">Cancel</a>
        </div>
    </EditForm>
}

</div>
</div>

@code {
    [Parameter] public int Id { get; set; }
    private Movie? movie;

    protected override async Task OnInitializedAsync() =>
        movie = await MovieQuery.GetByIdAsync(Id);

    private void OnDateWatchedChange(ChangeEventArgs e)
    {
        if (movie is null) return;
        var raw = e.Value?.ToString();
        movie.DateWatched = string.IsNullOrEmpty(raw) ? null : DateTime.Parse(raw);
    }

    private async Task Save()
    {
        if (movie is not null)
        {
            await MovieCommands.UpdateAsync(movie);
            Nav.NavigateTo($"/movies/{Id}");
        }
    }
}
