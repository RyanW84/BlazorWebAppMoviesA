@page "/movies"
@rendermode InteractiveServer
@inject IMovieService MovieService
@inject NavigationManager Nav
@inject IJSRuntime JS
@implements IAsyncDisposable

<PageTitle>Movies</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Movies</h1>
    <div class="d-flex gap-2">
        <a href="/export/movies.csv" class="btn btn-outline-secondary" download>Export CSV</a>
        <button class="btn btn-outline-secondary" @onclick="SurpriseMe">Surprise me</button>
        <button class="btn @(favoritesOnly ? "btn-danger" : "btn-outline-danger")" @onclick="ToggleFavoritesFilter" title="Favorites">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8.5.5a.5.5 0 0 0-1 0v.518A7 7 0 0 0 1.018 7.5H.5a.5.5 0 0 0 0 1h.518A7 7 0 0 0 7.5 14.982V15.5a.5.5 0 0 0 1 0v-.518A7 7 0 0 0 14.982 8.5H15.5a.5.5 0 0 0 0-1h-.518A7 7 0 0 0 8.5 1.018V.5ZM7 2.028V3.5a.5.5 0 0 0 1 0V2.028A6 6 0 0 1 13.972 8H12.5a.5.5 0 0 0 0 1h1.472A6 6 0 0 1 8 13.972V12.5a.5.5 0 0 0-1 0v1.472A6 6 0 0 1 2.028 8H3.5a.5.5 0 0 0 0-1H2.028A6 6 0 0 1 7 2.028ZM8 7a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"/></svg>
        </button>
        <a href="/movies/create" class="btn btn-primary">Add Movie</a>
    </div>
</div>

<div class="d-flex gap-2 mb-2 flex-wrap">
    <input id="movie-search" class="form-control" value="@searchTerm" @oninput="OnSearchInput" placeholder="Search title, director, genre… ( / )" />
    <select class="form-select" style="width:auto" value="@selectedGenre" @onchange="OnGenreChange">
        <option value="">All genres</option>
        @foreach (var g in genres)
        {
            <option value="@g">@g</option>
        }
    </select>
    <select class="form-select" style="width:auto" value="@selectedWatchStatus" @onchange="OnWatchStatusChange">
        <option value="">All statuses</option>
        <option value="WantToWatch">Want to Watch</option>
        <option value="Watched">Watched</option>
        <option value="Rewatching">Rewatching</option>
        <option value="None">No status</option>
    </select>
    <select class="form-select" style="width:auto" value="@pageSize" @onchange="OnPageSizeChange">
        <option value="25">25 / page</option>
        <option value="50">50 / page</option>
        <option value="100">100 / page</option>
    </select>
</div>
<div class="d-flex gap-2 mb-3 align-items-center flex-wrap">
    <span class="text-muted" style="font-size:0.8rem;white-space:nowrap;">Year:</span>
    <input type="number" class="form-control form-control-sm" style="width:90px" placeholder="From"
           value="@yearFrom" @onchange="OnYearFromChange" min="1888" max="2100" />
    <span class="text-muted" style="font-size:0.8rem;">–</span>
    <input type="number" class="form-control form-control-sm" style="width:90px" placeholder="To"
           value="@yearTo" @onchange="OnYearToChange" min="1888" max="2100" />
    <span class="text-muted ms-2" style="font-size:0.8rem;white-space:nowrap;">Min rating:</span>
    <select class="form-select form-select-sm" style="width:auto" value="@ratingMin" @onchange="OnRatingMinChange">
        <option value="">Any</option>
        <option value="5">5+</option>
        <option value="6">6+</option>
        <option value="7">7+</option>
        <option value="8">8+</option>
        <option value="9">9+</option>
    </select>
    @if (yearFrom.HasValue || yearTo.HasValue || ratingMin.HasValue)
    {
        <button class="btn btn-sm btn-outline-secondary" @onclick="ClearRangeFilters">Clear</button>
    }
</div>

@if (totalCount == 0)
{
    <p class="text-muted">No movies found.</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <small class="text-muted">
            Showing @((currentPage - 1) * pageSize + 1)–@(Math.Min(currentPage * pageSize, totalCount)) of @totalCount movies
        </small>
    </div>

    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th style="width:36px"></th>
                <th style="width:60px"></th>
                <th @onclick='() => SetSort("title")' style="cursor:pointer" class="user-select-none">
                    Title @SortIndicator("title")
                </th>
                <th @onclick='() => SetSort("year")' style="cursor:pointer" class="user-select-none">
                    Year @SortIndicator("year")
                </th>
                <th @onclick='() => SetSort("rating")' style="cursor:pointer" class="user-select-none">
                    Rating @SortIndicator("rating")
                </th>
                <th>Genre</th>
                <th>Director</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in movies)
            {
                <tr>
                    <td>
                        <button class="btn btn-sm btn-link p-0" style="color:@(movie.IsFavorite ? "#cc2200" : "#444");" @onclick="() => ToggleFavorite(movie)" title="@(movie.IsFavorite ? "Remove from favorites" : "Add to favorites")">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" viewBox="0 0 16 16"><path d="M8.5.5a.5.5 0 0 0-1 0v.518A7 7 0 0 0 1.018 7.5H.5a.5.5 0 0 0 0 1h.518A7 7 0 0 0 7.5 14.982V15.5a.5.5 0 0 0 1 0v-.518A7 7 0 0 0 14.982 8.5H15.5a.5.5 0 0 0 0-1h-.518A7 7 0 0 0 8.5 1.018V.5ZM7 2.028V3.5a.5.5 0 0 0 1 0V2.028A6 6 0 0 1 13.972 8H12.5a.5.5 0 0 0 0 1h1.472A6 6 0 0 1 8 13.972V12.5a.5.5 0 0 0-1 0v1.472A6 6 0 0 1 2.028 8H3.5a.5.5 0 0 0 0-1H2.028A6 6 0 0 1 7 2.028ZM8 7a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"/></svg>
                        </button>
                    </td>
                    <td>
                        <a href="/movies/@movie.Id">
                            @if (!string.IsNullOrEmpty(movie.PosterUrl))
                            {
                                <img src="@movie.PosterUrl" alt="@movie.Title" style="height:60px;width:40px;object-fit:cover;border-radius:3px;" />
                            }
                        </a>
                    </td>
                    <td><a href="/movies/@movie.Id" class="text-decoration-none text-body fw-semibold">@movie.Title</a></td>
                    <td>@movie.ReleaseYear</td>
                    <td>
                        @movie.Rating.ToString("F1")
                        @if (movie.PersonalRating.HasValue)
                        {
                            <span class="ms-1" style="color:#f5c518;font-size:0.8rem;" title="My rating: @movie.PersonalRating/5">
                                @(new string('★', movie.PersonalRating.Value))
                            </span>
                        }
                    </td>
                    <td>@movie.Genre</td>
                    <td>@movie.Director</td>
                    <td class="text-end">
                        <a href="/movies/@movie.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a href="/movies/@movie.Id/edit" class="btn btn-sm btn-outline-primary ms-1">Edit</a>
                        <a href="/movies/@movie.Id/delete" class="btn btn-sm btn-outline-danger ms-1">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (totalPages > 1)
    {
        <nav aria-label="Movie page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">&#8249;</button>
                </li>
                @foreach (var p in PageNumbers())
                {
                    @if (p == 0)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    else
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <button class="page-link" @onclick="() => GoToPage(p)">@p</button>
                        </li>
                    }
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">&#8250;</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    [Parameter][SupplyParameterFromQuery(Name = "search")]   public string? SearchParam      { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "genre")]    public string? GenreParam        { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "status")]   public string? StatusParam       { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "sort")]     public string? SortParam         { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "asc")]      public bool?   AscParam          { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "page")]     public int?    PageParam         { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "size")]     public int?    SizeParam         { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "favorites")]public bool    FavoritesParam    { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "yfrom")]    public int?    YearFromParam     { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "yto")]      public int?    YearToParam       { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "rmin")]       public decimal? RatingMinParam    { get; set; }
    [Parameter][SupplyParameterFromQuery(Name = "collection")] public int?     CollectionParam   { get; set; }

    private List<Movie> movies = [];
    private List<string> genres = [];
    private CancellationTokenSource? _searchCts;
    private string searchTerm = "";
    private string selectedGenre = "";
    private string selectedWatchStatus = "";
    private string sortBy = "title";
    private bool ascending = true;
    private bool favoritesOnly = false;
    private int currentPage = 1;
    private int pageSize = 25;
    private int totalCount = 0;
    private int? yearFrom;
    private int? yearTo;
    private decimal? ratingMin;
    private int? collectionId;
    private int totalPages => (int)Math.Ceiling((double)totalCount / pageSize);

    protected override async Task OnInitializedAsync()
    {
        searchTerm          = SearchParam    ?? "";
        selectedGenre       = GenreParam     ?? "";
        selectedWatchStatus = StatusParam    ?? "";
        sortBy              = SortParam      ?? "title";
        ascending           = AscParam       ?? true;
        currentPage         = PageParam      ?? 1;
        pageSize            = SizeParam      ?? 25;
        favoritesOnly       = FavoritesParam;
        yearFrom            = YearFromParam;
        yearTo              = YearToParam;
        ratingMin           = RatingMinParam;
        collectionId        = CollectionParam;
        genres = await MovieService.GetGenresAsync();
        await LoadMovies();
    }

    private async Task LoadMovies()
    {
        WatchStatus? watchStatusFilter = Enum.TryParse<WatchStatus>(selectedWatchStatus, out var parsed) ? parsed : null;
        var result = await MovieService.GetPagedAsync(searchTerm, selectedGenre, sortBy, ascending, currentPage, pageSize, favoritesOnly, watchStatusFilter, yearFrom, yearTo, ratingMin, collectionId);
        movies = result.Movies;
        totalCount = result.TotalCount;
    }

    private void PushUrl()
    {
        var url = Nav.GetUriWithQueryParameters("/movies", new Dictionary<string, object?>
        {
            ["search"]    = string.IsNullOrEmpty(searchTerm)          ? null : searchTerm,
            ["genre"]     = string.IsNullOrEmpty(selectedGenre)        ? null : selectedGenre,
            ["status"]    = string.IsNullOrEmpty(selectedWatchStatus)  ? null : selectedWatchStatus,
            ["sort"]      = sortBy == "title"                          ? null : sortBy,
            ["asc"]       = ascending                                  ? null : (object?)false,
            ["page"]      = currentPage == 1                           ? null : (object?)currentPage,
            ["size"]      = pageSize == 25                             ? null : (object?)pageSize,
            ["favorites"] = favoritesOnly                              ? (object?)true : null,
            ["yfrom"]      = yearFrom,
            ["yto"]        = yearTo,
            ["rmin"]       = ratingMin,
            ["collection"] = collectionId,
        });
        Nav.NavigateTo(url, replace: true);
    }

    private async Task ResetAndReload()
    {
        currentPage = 1;
        PushUrl();
        await LoadMovies();
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        _searchCts?.Cancel();
        _searchCts = new CancellationTokenSource();
        try
        {
            await Task.Delay(300, _searchCts.Token);
            await ResetAndReload();
        }
        catch (TaskCanceledException) { }
    }

    private async Task OnGenreChange(ChangeEventArgs e)
    {
        selectedGenre = e.Value?.ToString() ?? "";
        await ResetAndReload();
    }

    private async Task OnWatchStatusChange(ChangeEventArgs e)
    {
        selectedWatchStatus = e.Value?.ToString() ?? "";
        await ResetAndReload();
    }

    private async Task OnYearFromChange(ChangeEventArgs e)
    {
        yearFrom = int.TryParse(e.Value?.ToString(), out var y) ? y : null;
        await ResetAndReload();
    }

    private async Task OnYearToChange(ChangeEventArgs e)
    {
        yearTo = int.TryParse(e.Value?.ToString(), out var y) ? y : null;
        await ResetAndReload();
    }

    private async Task OnRatingMinChange(ChangeEventArgs e)
    {
        ratingMin = decimal.TryParse(e.Value?.ToString(), out var r) ? r : null;
        await ResetAndReload();
    }

    private async Task ClearRangeFilters()
    {
        yearFrom = null;
        yearTo = null;
        ratingMin = null;
        await ResetAndReload();
    }

    private async Task SetSort(string column)
    {
        ascending = sortBy == column ? !ascending : true;
        sortBy = column;
        await ResetAndReload();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        PushUrl();
        await LoadMovies();
    }

    private async Task OnPageSizeChange(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value?.ToString() ?? "25");
        await ResetAndReload();
    }

    private async Task ToggleFavorite(Movie movie)
    {
        await MovieService.ToggleFavoriteAsync(movie.Id);
        movie.IsFavorite = !movie.IsFavorite;
    }

    private async Task ToggleFavoritesFilter()
    {
        favoritesOnly = !favoritesOnly;
        await ResetAndReload();
    }

    private async Task SurpriseMe()
    {
        var id = await MovieService.GetRandomIdAsync();
        if (id is not null) Nav.NavigateTo($"/movies/{id}");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("eval", """
                (function() {
                    window.__movieSearchHandler = function(e) {
                        if (e.key === '/' && document.activeElement.tagName !== 'INPUT' && document.activeElement.tagName !== 'TEXTAREA' && document.activeElement.tagName !== 'SELECT') {
                            e.preventDefault();
                            document.getElementById('movie-search')?.focus();
                        }
                    };
                    document.addEventListener('keydown', window.__movieSearchHandler);
                })();
                """);
        }
    }

    public async ValueTask DisposeAsync()
    {
        await JS.InvokeVoidAsync("eval",
            "if (window.__movieSearchHandler) { document.removeEventListener('keydown', window.__movieSearchHandler); delete window.__movieSearchHandler; }");
    }

    private string SortIndicator(string column) => sortBy == column ? (ascending ? " ↑" : " ↓") : "";

    private IEnumerable<int> PageNumbers()
    {
        if (totalPages <= 7)
            return Enumerable.Range(1, totalPages);

        var pages = new List<int> { 1 };

        if (currentPage > 3) pages.Add(0);

        for (var p = Math.Max(2, currentPage - 1); p <= Math.Min(totalPages - 1, currentPage + 1); p++)
            pages.Add(p);

        if (currentPage < totalPages - 2) pages.Add(0);

        pages.Add(totalPages);
        return pages;
    }
}
