@page "/movies"
@rendermode InteractiveServer
@inject IMovieService MovieService
@inject NavigationManager Nav

<PageTitle>Movies</PageTitle>

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Movies</h1>
    <div class="d-flex gap-2">
        <button class="btn btn-outline-secondary" @onclick="SurpriseMe">Surprise me</button>
        <button class="btn @(favoritesOnly ? "btn-danger" : "btn-outline-danger")" @onclick="ToggleFavoritesFilter" title="Favorites">&#9829;</button>
        <a href="/movies/create" class="btn btn-primary">Add Movie</a>
    </div>
</div>

<div class="d-flex gap-2 mb-3">
    <input class="form-control" value="@searchTerm" @oninput="OnSearchInput" placeholder="Search title, director, genre…" />
    <select class="form-select" style="width:auto" value="@selectedGenre" @onchange="OnGenreChange">
        <option value="">All genres</option>
        @foreach (var g in genres)
        {
            <option value="@g">@g</option>
        }
    </select>
    <select class="form-select" style="width:auto" value="@pageSize" @onchange="OnPageSizeChange">
        <option value="25">25 / page</option>
        <option value="50">50 / page</option>
        <option value="100">100 / page</option>
    </select>
</div>

@if (totalCount == 0)
{
    <p class="text-muted">No movies found.</p>
}
else
{
    <div class="d-flex justify-content-between align-items-center mb-2">
        <small class="text-muted">
            Showing @((currentPage - 1) * pageSize + 1)–@(Math.Min(currentPage * pageSize, totalCount)) of @totalCount movies
        </small>
    </div>

    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th style="width:36px"></th>
                <th style="width:60px"></th>
                <th @onclick='() => SetSort("title")' style="cursor:pointer" class="user-select-none">
                    Title @SortIndicator("title")
                </th>
                <th @onclick='() => SetSort("year")' style="cursor:pointer" class="user-select-none">
                    Year @SortIndicator("year")
                </th>
                <th @onclick='() => SetSort("rating")' style="cursor:pointer" class="user-select-none">
                    Rating @SortIndicator("rating")
                </th>
                <th>Genre</th>
                <th>Director</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var movie in movies)
            {
                <tr>
                    <td>
                        <button class="btn btn-sm btn-link p-0" style="color:@(movie.IsFavorite ? "#cc2200" : "#444"); font-size:1rem;" @onclick="() => ToggleFavorite(movie)" title="@(movie.IsFavorite ? "Remove from favorites" : "Add to favorites")">&#9829;</button>
                    </td>
                    <td>
                        <a href="/movies/@movie.Id">
                            @if (!string.IsNullOrEmpty(movie.PosterUrl))
                            {
                                <img src="@movie.PosterUrl" alt="@movie.Title" style="height:60px;width:40px;object-fit:cover;border-radius:3px;" />
                            }
                        </a>
                    </td>
                    <td><a href="/movies/@movie.Id" class="text-decoration-none text-body fw-semibold">@movie.Title</a></td>
                    <td>@movie.ReleaseYear</td>
                    <td>@movie.Rating.ToString("F1")</td>
                    <td>@movie.Genre</td>
                    <td>@movie.Director</td>
                    <td class="text-end">
                        <a href="/movies/@movie.Id" class="btn btn-sm btn-outline-secondary">Details</a>
                        <a href="/movies/@movie.Id/edit" class="btn btn-sm btn-outline-primary ms-1">Edit</a>
                        <a href="/movies/@movie.Id/delete" class="btn btn-sm btn-outline-danger ms-1">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (totalPages > 1)
    {
        <nav aria-label="Movie page navigation">
            <ul class="pagination justify-content-center">
                <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage - 1)">&#8249;</button>
                </li>
                @foreach (var p in PageNumbers())
                {
                    @if (p == 0)
                    {
                        <li class="page-item disabled"><span class="page-link">…</span></li>
                    }
                    else
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <button class="page-link" @onclick="() => GoToPage(p)">@p</button>
                        </li>
                    }
                }
                <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                    <button class="page-link" @onclick="() => GoToPage(currentPage + 1)">&#8250;</button>
                </li>
            </ul>
        </nav>
    }
}

@code {
    private List<Movie> movies = [];
    private List<string> genres = [];
    private string searchTerm = "";
    private string selectedGenre = "";
    private string sortBy = "title";
    private bool ascending = true;
    private bool favoritesOnly = false;
    private int currentPage = 1;
    private int pageSize = 25;
    private int totalCount = 0;
    private int totalPages => (int)Math.Ceiling((double)totalCount / pageSize);

    protected override async Task OnInitializedAsync()
    {
        genres = await MovieService.GetGenresAsync();
        await LoadMovies();
    }

    private async Task LoadMovies()
    {
        var result = await MovieService.GetPagedAsync(searchTerm, selectedGenre, sortBy, ascending, currentPage, pageSize, favoritesOnly);
        movies = result.Movies;
        totalCount = result.TotalCount;
    }

    private async Task OnSearchInput(ChangeEventArgs e)
    {
        searchTerm = e.Value?.ToString() ?? "";
        currentPage = 1;
        await LoadMovies();
    }

    private async Task OnGenreChange(ChangeEventArgs e)
    {
        selectedGenre = e.Value?.ToString() ?? "";
        currentPage = 1;
        await LoadMovies();
    }

    private async Task SetSort(string column)
    {
        ascending = sortBy == column ? !ascending : true;
        sortBy = column;
        currentPage = 1;
        await LoadMovies();
    }

    private async Task GoToPage(int page)
    {
        if (page < 1 || page > totalPages) return;
        currentPage = page;
        await LoadMovies();
    }

    private async Task OnPageSizeChange(ChangeEventArgs e)
    {
        pageSize = int.Parse(e.Value?.ToString() ?? "25");
        currentPage = 1;
        await LoadMovies();
    }

    private async Task ToggleFavorite(Movie movie)
    {
        await MovieService.ToggleFavoriteAsync(movie.Id);
        movie.IsFavorite = !movie.IsFavorite;
    }

    private async Task ToggleFavoritesFilter()
    {
        favoritesOnly = !favoritesOnly;
        currentPage = 1;
        await LoadMovies();
    }

    private async Task SurpriseMe()
    {
        var id = await MovieService.GetRandomIdAsync();
        if (id is not null) Nav.NavigateTo($"/movies/{id}");
    }

    private string SortIndicator(string column) => sortBy == column ? (ascending ? " ↑" : " ↓") : "";

    private IEnumerable<int> PageNumbers()
    {
        if (totalPages <= 7)
            return Enumerable.Range(1, totalPages);

        var pages = new List<int> { 1 };

        if (currentPage > 3) pages.Add(0);

        for (var p = Math.Max(2, currentPage - 1); p <= Math.Min(totalPages - 1, currentPage + 1); p++)
            pages.Add(p);

        if (currentPage < totalPages - 2) pages.Add(0);

        pages.Add(totalPages);
        return pages;
    }
}
