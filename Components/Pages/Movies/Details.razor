@page "/movies/{Id:int}"
@rendermode InteractiveServer
@inject IMovieQueryService   MovieQuery
@inject IMovieCommandService MovieCommands
@inject ITmdbCreditService   TmdbCredits
@inject ITmdbMediaService    TmdbMedia
@inject IMovieImportOrchestrator Importer

<PageTitle>@(movie?.Title ?? "Movie")</PageTitle>

@if (movie is null)
{
    <div class="archive-terminal">
        <div class="archive-header">
            <span>SKYNET ARCHIVE // FILE RECORD <span class="record-id">NOT FOUND</span></span>
            <span class="header-status"><span class="status-dot-err">◉</span> ERROR</span>
        </div>
        <div class="archive-body">
            <p class="text-muted">// RECORD NOT FOUND IN DATABASE</p>
        </div>
    </div>
}
else
{
    @if (!string.IsNullOrEmpty(backdropUrl))
    {
        <div class="details-hero" style="background-image:url('@backdropUrl')"></div>
    }
    <div class="archive-terminal">

        <div class="archive-header">
            <span>SKYNET ARCHIVE // FILE RECORD <span class="record-id">#@movie.Id.ToString("D5")</span></span>
            <span class="header-status"><span class="status-dot">◉</span> ACTIVE</span>
        </div>

        <div class="archive-body">
            <div class="row g-4">

                <div class="col-md-3">
                    <div class="poster-frame">
                        @if (!string.IsNullOrEmpty(movie.PosterUrl))
                        {
                            <img src="@movie.PosterUrl" alt="@movie.Title poster" class="poster-img" />
                            @if (movie.TmdbId is not null)
                            {
                                <div class="poster-overlay">TMDB: @movie.TmdbId.Value.ToString("D7")</div>
                            }
                        }
                        else
                        {
                            <div class="poster-placeholder">
                                <span>// NO VISUAL</span>
                                <span>// DATA</span>
                            </div>
                        }
                    </div>
                    @if (movie.IsFavorite)
                    {
                        <div class="classified-badge mt-2">◈ CLASSIFIED</div>
                    }
                </div>

                <div class="col-md-9">
                    <div class="archive-title">@movie.Title</div>

                    <div class="field-grid mt-3">
                        <div class="field-row">
                            <span class="field-label">YEAR</span>
                            <span class="field-dots"></span>
                            <span class="field-value">@movie.ReleaseYear</span>
                        </div>
                        @if (movie.RuntimeMinutes is int rt)
                        {
                            <div class="field-row">
                                <span class="field-label">RUNTIME</span>
                                <span class="field-dots"></span>
                                <span class="field-value">@(rt / 60 > 0 ? $"{rt / 60}h " : "")@(rt % 60)m</span>
                            </div>
                        }
                        <div class="field-row">
                            <span class="field-label">CLASSIFICATION</span>
                            <span class="field-dots"></span>
                            <span class="field-value">@(movie.Genre ?? "// UNKNOWN")</span>
                        </div>
                        <div class="field-row">
                            <span class="field-label">ARCHITECT</span>
                            <span class="field-dots"></span>
                            <span class="field-value">
                                @if (movie.DirectorTmdbId is not null)
                                {
                                    <a href="/person/@movie.DirectorTmdbId" class="person-link">@(movie.Director ?? "// UNKNOWN")</a>
                                }
                                else
                                {
                                    @(movie.Director ?? "// UNKNOWN")
                                }
                            </span>
                        </div>
                        <div class="field-row">
                            <span class="field-label">TMDB RATING</span>
                            <span class="field-dots"></span>
                            <span class="field-value">@movie.Rating.ToString("F1") <span class="rating-max">/ 10</span></span>
                        </div>
                        <div class="field-row">
                            <span class="field-label">MY RATING</span>
                            <span class="field-dots"></span>
                            <span class="field-value">
                                @for (var i = 1; i <= 5; i++)
                                {
                                    var star = i;
                                    <button class="btn btn-link p-0 me-1" style="font-size:1.1rem;color:@(movie.PersonalRating.HasValue && movie.PersonalRating >= star ? "#f5c518" : "#555");"
                                            @onclick="() => SetPersonalRating(star)" title="Rate @star/5">★</button>
                                }
                                @if (movie.PersonalRating.HasValue)
                                {
                                    <button class="btn btn-link p-0 ms-1 text-muted" style="font-size:0.75rem;" @onclick="() => SetPersonalRating(null)">clear</button>
                                }
                            </span>
                        </div>
                        <div class="field-row">
                            <span class="field-label">DATE WATCHED</span>
                            <span class="field-dots"></span>
                            <span class="field-value d-flex align-items-center gap-2">
                                <input type="date" class="form-control form-control-sm" style="width:auto;background:#111;color:#ccc;border-color:#333;"
                                       value="@(movie.DateWatched?.ToString("yyyy-MM-dd") ?? "")"
                                       @onchange="OnDateWatchedChange" />
                                @if (movie.DateWatched.HasValue)
                                {
                                    <button class="btn btn-link p-0 text-muted" style="font-size:0.75rem;" @onclick="() => SetWatchDate(null)">clear</button>
                                }
                            </span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(movie.Synopsis))
                    {
                        <div class="synopsis-block mt-3">
                            <div class="synopsis-header">// SYNOPSIS</div>
                            <p class="synopsis-text">@movie.Synopsis</p>
                        </div>
                    }

                    <div class="synopsis-block mt-3">
                        <div class="synopsis-header d-flex justify-content-between align-items-center">
                            <span>// PERSONAL NOTES</span>
                            @if (!editingNotes)
                            {
                                <button class="btn btn-link p-0 text-muted" style="font-size:0.75rem;" @onclick="StartEditNotes">EDIT</button>
                            }
                        </div>
                        @if (editingNotes)
                        {
                            <textarea class="form-control mt-1" rows="4"
                                      style="background:#111;color:#ccc;border-color:#333;font-family:monospace;"
                                      @bind="notesBuffer"></textarea>
                            <div class="d-flex gap-2 mt-1">
                                <button class="btn btn-sm btn-primary" @onclick="SaveNotes">SAVE</button>
                                <button class="btn btn-sm btn-outline-secondary" @onclick="CancelEditNotes">CANCEL</button>
                            </div>
                        }
                        else if (!string.IsNullOrWhiteSpace(movie.Notes))
                        {
                            <p class="synopsis-text">@movie.Notes</p>
                        }
                        else
                        {
                            <p class="synopsis-text text-muted">// NO NOTES RECORDED</p>
                        }
                    </div>

                    <div class="action-bar">
                        <a href="/movies" class="btn btn-outline-secondary btn-sm">← BACK</a>
                        <a href="/movies/@movie.Id/edit" class="btn btn-primary btn-sm">EDIT RECORD</a>
                        <a href="/movies/@movie.Id/delete" class="btn btn-danger btn-sm">DELETE</a>
                        <form method="post" @formname="toggle-favorite" @onsubmit="ToggleFavorite" class="d-inline">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-sm @(movie.IsFavorite ? "btn-danger" : "btn-outline-danger")">
                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="currentColor" viewBox="0 0 16 16"><path d="M8.5.5a.5.5 0 0 0-1 0v.518A7 7 0 0 0 1.018 7.5H.5a.5.5 0 0 0 0 1h.518A7 7 0 0 0 7.5 14.982V15.5a.5.5 0 0 0 1 0v-.518A7 7 0 0 0 14.982 8.5H15.5a.5.5 0 0 0 0-1h-.518A7 7 0 0 0 8.5 1.018V.5ZM7 2.028V3.5a.5.5 0 0 0 1 0V2.028A6 6 0 0 1 13.972 8H12.5a.5.5 0 0 0 0 1h1.472A6 6 0 0 1 8 13.972V12.5a.5.5 0 0 0-1 0v1.472A6 6 0 0 1 2.028 8H3.5a.5.5 0 0 0 0-1H2.028A6 6 0 0 1 7 2.028ZM8 7a1 1 0 1 1 0 2 1 1 0 0 1 0-2Z"/></svg>
                                @(movie.IsFavorite ? "CLASSIFIED" : "CLASSIFY")
                            </button>
                        </form>
                    </div>

                    <div class="watch-status-bar mt-2">
                        <span class="field-label me-2">STATUS</span>
                        @foreach (var s in Enum.GetValues<WatchStatus>().Where(s => s != WatchStatus.None))
                        {
                            <button class="btn btn-sm @(movie.WatchStatus == s ? WatchStatusActiveClass(s) : "btn-outline-secondary") me-1"
                                    @onclick="() => SetWatchStatus(s)">
                                @WatchStatusLabel(s)
                            </button>
                        }
                        @if (movie.WatchStatus != WatchStatus.None)
                        {
                            <button class="btn btn-sm btn-link text-muted p-0 ms-1" @onclick="() => SetWatchStatus(WatchStatus.None)">clear</button>
                        }
                    </div>
                </div>

            </div>
        </div>

        <!-- Tags panel -->
        <div class="terminal-panel">
            <div class="panel-header">TAGS</div>
            <div class="panel-body">
                <div class="d-flex flex-wrap gap-2 mb-2">
                    @foreach (var tag in tags)
                    {
                        <span class="tag-chip">
                            <a href="/movies?tag=@Uri.EscapeDataString(tag)" class="text-decoration-none tag-label">@tag</a>
                            <button class="btn btn-link p-0 tag-remove" @onclick="() => RemoveTag(tag)" title="Remove tag">×</button>
                        </span>
                    }
                    @if (tags.Count == 0)
                    {
                        <span class="text-muted" style="font-size:0.8rem;">// NO TAGS</span>
                    }
                </div>
                <div class="d-flex gap-2 align-items-center">
                    <input class="form-control form-control-sm tag-input" placeholder="Add tag…" @bind="newTag" @onkeydown="OnTagKeyDown" list="tag-suggestions" />
                    <datalist id="tag-suggestions">
                        @foreach (var t in allTags.Where(t => !tags.Contains(t)))
                        {
                            <option value="@t" />
                        }
                    </datalist>
                    <button class="btn btn-sm btn-outline-secondary" @onclick="AddTag">ADD</button>
                </div>
            </div>
        </div>

        <!-- Watch log panel -->
        <div class="terminal-panel">
            <div class="panel-header">WATCH LOG</div>
            <div class="panel-body">
                @if (watchLog.Count > 0)
                {
                    <table class="table table-sm mb-3" style="font-size:0.8rem;color:#aaa;">
                        <tbody>
                            @foreach (var entry in watchLog)
                            {
                                <tr>
                                    <td style="color:#cc2200;white-space:nowrap;">@entry.WatchedOn.ToString("yyyy-MM-dd")</td>
                                    <td>@(entry.Notes ?? "")</td>
                                    <td class="text-end">
                                        <button class="btn btn-link p-0 text-muted" style="font-size:0.7rem;" @onclick="() => DeleteLogEntry(entry.Id)">✕</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
                <div class="d-flex gap-2 align-items-center flex-wrap">
                    <input type="date" class="form-control form-control-sm" style="width:auto;background:#111;color:#ccc;border-color:#333;"
                           @bind="newLogDate" />
                    <input class="form-control form-control-sm" placeholder="Notes (optional)" @bind="newLogNotes" style="flex:1;min-width:140px;" />
                    <button class="btn btn-sm btn-outline-secondary" @onclick="AddLogEntry">LOG</button>
                </div>
            </div>
        </div>

        <CastPanel Cast="@movie.Cast" />
        <CollectionPanel Collection="@collection" LocalIds="@collectionLocalIds" CurrentTmdbId="@(movie.TmdbId ?? 0)" />
        <WatchProvidersPanel Providers="@watchProviders" />
        <TrailerPanel TrailerKey="@trailerKey" MovieTitle="@movie.Title" />
        <RecommendationsPanel Recommendations="@recommendations" LocalIds="@recommendationLocalIds" />

    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Movie? movie;
    private string? trailerKey;
    private TmdbWatchRegion? watchProviders;
    private List<TmdbMovieResult> recommendations = [];
    private Dictionary<int, int> recommendationLocalIds = [];
    private TmdbCollectionDetails? collection;
    private Dictionary<int, int> collectionLocalIds = [];
    private bool editingNotes;
    private string notesBuffer = "";
    private List<string> tags = [];
    private List<string> allTags = [];
    private string newTag = "";
    private List<WatchLogEntry> watchLog = [];
    private DateTime newLogDate = DateTime.Today;
    private string newLogNotes = "";
    private string? backdropUrl;

    protected override async Task OnInitializedAsync()
    {
        movie = await MovieQuery.GetByIdAsync(Id);
        var tagsTask    = MovieQuery.GetTagsForMovieAsync(Id);
        var allTagsTask = MovieQuery.GetAllTagsAsync();
        var logTask     = MovieQuery.GetWatchLogAsync(Id);

        if (movie?.TmdbId is not int tmdbId)
        {
            await Task.WhenAll(tagsTask, allTagsTask, logTask);
            tags = tagsTask.Result; allTags = allTagsTask.Result; watchLog = logTask.Result;
            return;
        }

        var trailerTask    = TmdbMedia.GetTrailerKeyAsync(tmdbId);
        var backdropTask   = TmdbMedia.GetBackdropUrlAsync(tmdbId);
        var providersTask  = TmdbMedia.GetWatchProvidersAsync(tmdbId);
        var recsTask       = TmdbMedia.GetRecommendationsAsync(tmdbId);

        bool needsCredits = movie.Cast.Count == 0
            || movie.Cast.Any(c => c.TmdbPersonId is null)
            || (movie.DirectorTmdbId is null && !string.IsNullOrEmpty(movie.Director));

        Task<(List<CastMember> Cast, int? DirectorTmdbId)>? creditsTask = needsCredits
            ? TmdbCredits.FetchCreditsAsync(tmdbId)
            : null;

        Task<TmdbCollectionDetails?>? collectionTask = movie.CollectionId is int colId
            ? TmdbMedia.GetCollectionAsync(colId)
            : null;

        var tasks = new List<Task> { trailerTask, backdropTask, providersTask, recsTask, tagsTask, allTagsTask, logTask };
        if (creditsTask is not null) tasks.Add(creditsTask);
        if (collectionTask is not null) tasks.Add(collectionTask);
        await Task.WhenAll(tasks);

        tags    = tagsTask.Result;
        allTags = allTagsTask.Result;
        watchLog = logTask.Result;

        trailerKey      = trailerTask.Result;
        backdropUrl     = backdropTask.Result;
        watchProviders  = providersTask.Result;
        recommendations = recsTask.Result;

        if (creditsTask is not null)
        {
            var (fetchedCast, directorTmdbId) = creditsTask.Result;
            await MovieCommands.BackfillPersonIdsAsync(movie.Id, directorTmdbId, fetchedCast);
            movie = await MovieQuery.GetByIdAsync(Id);
        }

        if (collectionTask is not null)
        {
            collection = collectionTask.Result;
            if (collection is not null)
            {
                var colTmdbIds = collection.Parts.Select(p => p.Id);
                collectionLocalIds = await Importer.EnsureLocalAsync(colTmdbIds);
            }
        }

        if (recommendations.Count > 0)
        {
            var tmdbIds = recommendations.Select(r => r.Id);
            recommendationLocalIds = await Importer.EnsureLocalAsync(tmdbIds);
        }
    }

    private async Task ToggleFavorite()
    {
        if (movie is null) return;
        await MovieCommands.ToggleFavoriteAsync(movie.Id);
        movie.IsFavorite = !movie.IsFavorite;
    }

    private async Task SetPersonalRating(int? rating)
    {
        if (movie is null) return;
        await MovieCommands.SetPersonalRatingAsync(movie.Id, rating);
        movie.PersonalRating = rating;
    }

    private async Task SetWatchStatus(WatchStatus status)
    {
        if (movie is null) return;
        await MovieCommands.SetWatchStatusAsync(movie.Id, status);
        movie.WatchStatus = status;
    }

    private async Task OnDateWatchedChange(ChangeEventArgs e)
    {
        var raw = e.Value?.ToString();
        var date = string.IsNullOrEmpty(raw) ? (DateTime?)null : DateTime.Parse(raw);
        await SetWatchDate(date);
    }

    private async Task SetWatchDate(DateTime? date)
    {
        if (movie is null) return;
        await MovieCommands.SetWatchDateAsync(movie.Id, date);
        movie.DateWatched = date;
    }

    private void StartEditNotes()
    {
        notesBuffer = movie?.Notes ?? "";
        editingNotes = true;
    }

    private async Task SaveNotes()
    {
        if (movie is null) return;
        await MovieCommands.SetNotesAsync(movie.Id, string.IsNullOrWhiteSpace(notesBuffer) ? null : notesBuffer);
        movie.Notes = string.IsNullOrWhiteSpace(notesBuffer) ? null : notesBuffer;
        editingNotes = false;
    }

    private void CancelEditNotes()
    {
        editingNotes = false;
        notesBuffer = "";
    }

    private async Task AddTag()
    {
        if (movie is null || string.IsNullOrWhiteSpace(newTag)) return;
        await MovieCommands.AddTagAsync(movie.Id, newTag);
        tags = await MovieQuery.GetTagsForMovieAsync(movie.Id);
        allTags = await MovieQuery.GetAllTagsAsync();
        newTag = "";
    }

    private async Task OnTagKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await AddTag();
    }

    private async Task RemoveTag(string tag)
    {
        if (movie is null) return;
        await MovieCommands.RemoveTagAsync(movie.Id, tag);
        tags.Remove(tag);
    }

    private async Task AddLogEntry()
    {
        if (movie is null) return;
        var entry = new WatchLogEntry { MovieId = movie.Id, WatchedOn = newLogDate, Notes = string.IsNullOrWhiteSpace(newLogNotes) ? null : newLogNotes };
        await MovieCommands.AddWatchLogEntryAsync(entry);
        watchLog = await MovieQuery.GetWatchLogAsync(movie.Id);
        newLogNotes = "";
        newLogDate = DateTime.Today;
    }

    private async Task DeleteLogEntry(int entryId)
    {
        await MovieCommands.DeleteWatchLogEntryAsync(entryId);
        watchLog.RemoveAll(w => w.Id == entryId);
    }

    private static string WatchStatusLabel(WatchStatus s) => s switch
    {
        WatchStatus.WantToWatch => "WANT TO WATCH",
        WatchStatus.Watched     => "WATCHED",
        WatchStatus.Rewatching  => "REWATCHING",
        _                       => s.ToString().ToUpper(),
    };

    private static string WatchStatusActiveClass(WatchStatus s) => s switch
    {
        WatchStatus.WantToWatch => "btn-info",
        WatchStatus.Watched     => "btn-success",
        WatchStatus.Rewatching  => "btn-warning",
        _                       => "btn-secondary",
    };
}
