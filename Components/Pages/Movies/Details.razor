@page "/movies/{Id:int}"
@inject IMovieService MovieService
@inject ITmdbService TmdbService

<PageTitle>@(movie?.Title ?? "Movie")</PageTitle>

@if (movie is null)
{
    <p>Movie not found.</p>
}
else
{
    <div class="row g-4">
        <div class="col-md-3">
            @if (!string.IsNullOrEmpty(movie.PosterUrl))
            {
                <img src="@movie.PosterUrl" class="img-fluid rounded shadow" alt="@movie.Title poster" />
            }
            else
            {
                <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="height:300px;color:white;">No poster</div>
            }
        </div>
        <div class="col-md-9">
            <h1>@movie.Title</h1>
            <dl class="row mt-3">
                <dt class="col-sm-3">Year</dt>
                <dd class="col-sm-9">@movie.ReleaseYear</dd>
                <dt class="col-sm-3">Genre</dt>
                <dd class="col-sm-9">@(movie.Genre ?? "—")</dd>
                <dt class="col-sm-3">Director</dt>
                <dd class="col-sm-9">@(movie.Director ?? "—")</dd>
                <dt class="col-sm-3">Rating</dt>
                <dd class="col-sm-9">@movie.Rating.ToString("F1") / 10</dd>
            </dl>
            @if (!string.IsNullOrEmpty(movie.Synopsis))
            {
                <p class="mt-2">@movie.Synopsis</p>
            }

            @if (movie.Cast.Count > 0)
            {
                <div class="mt-3">
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var member in movie.Cast)
                        {
                            <div class="text-center" style="width:80px;">
                                @if (member.ProfileUrl is not null)
                                {
                                    <img src="@member.ProfileUrl" alt="@member.Name"
                                         style="width:64px;height:64px;object-fit:cover;border-radius:50%;" />
                                }
                                else
                                {
                                    <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center mx-auto"
                                         style="width:64px;height:64px;color:white;font-size:1.2rem;">
                                        @member.Name[0]
                                    </div>
                                }
                                <small class="d-block mt-1 fw-semibold" style="font-size:0.7rem;line-height:1.2;">@member.Name</small>
                                @if (!string.IsNullOrEmpty(member.Character))
                                {
                                    <small class="text-muted" style="font-size:0.65rem;">@member.Character</small>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="d-flex gap-2 mt-3 align-items-center">
                <a href="/movies" class="btn btn-outline-secondary">Back</a>
                <a href="/movies/@movie.Id/edit" class="btn btn-primary">Edit</a>
                <a href="/movies/@movie.Id/delete" class="btn btn-danger">Delete</a>
                @if (movie.TmdbId is not null && movie.Cast.Count == 0)
                {
                    <form method="post" @formname="load-cast" @onsubmit="LoadCast">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Load cast</button>
                    </form>
                }
            </div>
        </div>
    </div>

    @if (watchProviders is not null && (watchProviders.Flatrate.Count > 0 || watchProviders.Rent.Count > 0 || watchProviders.Buy.Count > 0))
    {
        <div class="mt-4">
            <h5>Where to Watch</h5>
            @WatchProviderRow("Stream", watchProviders.Flatrate)
            @WatchProviderRow("Rent", watchProviders.Rent)
            @WatchProviderRow("Buy", watchProviders.Buy)
            @if (watchProviders.Link is not null)
            {
                <small><a href="@watchProviders.Link" target="_blank" rel="noopener noreferrer" class="text-muted">Full availability on JustWatch</a></small>
            }
        </div>
    }

    @if (trailerKey is not null)
    {
        <div class="mt-4">
            <h5>Trailer</h5>
            <div class="ratio ratio-16x9" style="max-width:720px;">
                <iframe src="https://www.youtube.com/embed/@trailerKey"
                        title="@movie.Title trailer"
                        allowfullscreen
                        referrerpolicy="strict-origin-when-cross-origin">
                </iframe>
            </div>
        </div>
    }

    @if (recommendations.Count > 0)
    {
        <div class="mt-4">
            <h5>More Like This</h5>
            <div class="d-flex gap-3 overflow-auto pb-2">
                @foreach (var rec in recommendations)
                {
                    var year = rec.ReleaseDate?.Split('-')[0];
                    var posterSrc = rec.PosterPath != null
                        ? $"https://image.tmdb.org/t/p/w154{rec.PosterPath}"
                        : null;

                    @if (recommendationLocalIds.TryGetValue(rec.Id, out var localId))
                    {
                        <a href="/movies/@localId" class="text-decoration-none flex-shrink-0" style="width:100px;">
                            @RecommendationCard(rec.Title, year, posterSrc)
                        </a>
                    }
                    else
                    {
                        <div class="flex-shrink-0" style="width:100px;">
                            @RecommendationCard(rec.Title, year, posterSrc)
                        </div>
                    }
                }
            </div>
        </div>
    }

}

@code {
    [Parameter] public int Id { get; set; }
    private Movie? movie;
    private string? trailerKey;
    private TmdbWatchRegion? watchProviders;
    private List<TmdbMovieResult> recommendations = [];
    private Dictionary<int, int> recommendationLocalIds = [];

    protected override async Task OnInitializedAsync()
    {
        movie = await MovieService.GetByIdAsync(Id);
        if (movie?.TmdbId is int tmdbId)
        {
            var trailerTask = TmdbService.GetTrailerKeyAsync(tmdbId);
            var providersTask = TmdbService.GetWatchProvidersAsync(tmdbId);
            var recsTask = TmdbService.GetRecommendationsAsync(tmdbId);
            await Task.WhenAll(trailerTask, providersTask, recsTask);
            trailerKey = trailerTask.Result;
            watchProviders = providersTask.Result;
            recommendations = recsTask.Result;

            if (recommendations.Count > 0)
            {
                var tmdbIds = recommendations.Select(r => r.Id);
                recommendationLocalIds = await MovieService.GetLocalIdsByTmdbIdsAsync(tmdbIds);
            }
        }
    }

    private static readonly string LogoBase = "https://image.tmdb.org/t/p/w45";

    private RenderFragment RecommendationCard(string title, string? year, string? posterSrc) => __builder =>
    {
        if (posterSrc is not null)
        {
            __builder.OpenElement(0, "img");
            __builder.AddAttribute(1, "src", posterSrc);
            __builder.AddAttribute(2, "alt", title);
            __builder.AddAttribute(3, "style", "width:100px;height:150px;object-fit:cover;border-radius:4px;display:block;");
            __builder.CloseElement();
        }
        else
        {
            __builder.OpenElement(0, "div");
            __builder.AddAttribute(1, "class", "bg-secondary d-flex align-items-center justify-content-center");
            __builder.AddAttribute(2, "style", "width:100px;height:150px;border-radius:4px;color:white;font-size:0.7rem;text-align:center;padding:4px;");
            __builder.AddContent(3, title);
            __builder.CloseElement();
        }
        __builder.OpenElement(4, "small");
        __builder.AddAttribute(5, "class", "d-block mt-1 text-body");
        __builder.AddAttribute(6, "style", "font-size:0.7rem;line-height:1.3;");
        __builder.AddContent(7, title);
        __builder.CloseElement();
        if (year is not null)
        {
            __builder.OpenElement(8, "small");
            __builder.AddAttribute(9, "class", "text-muted");
            __builder.AddAttribute(10, "style", "font-size:0.65rem;");
            __builder.AddContent(11, year);
            __builder.CloseElement();
        }
    };

    private RenderFragment WatchProviderRow(string label, List<TmdbWatchProvider> providers) => __builder =>
    {
        if (providers.Count == 0) return;
        __builder.OpenElement(0, "div");
        __builder.AddAttribute(1, "class", "d-flex align-items-center gap-2 mb-2");
        __builder.OpenElement(2, "small");
        __builder.AddAttribute(3, "class", "text-muted me-1");
        __builder.AddAttribute(4, "style", "width:3.5rem;");
        __builder.AddContent(5, label);
        __builder.CloseElement();
        foreach (var p in providers.OrderBy(p => p.DisplayPriority).Take(8))
        {
            __builder.OpenElement(6, "img");
            __builder.AddAttribute(7, "src", p.LogoPath != null ? $"{LogoBase}{p.LogoPath}" : "");
            __builder.AddAttribute(8, "alt", p.Name);
            __builder.AddAttribute(9, "title", p.Name);
            __builder.AddAttribute(10, "style", "width:36px;height:36px;border-radius:6px;");
            __builder.CloseElement();
        }
        __builder.CloseElement();
    };

    private async Task LoadCast()
    {
        if (movie?.TmdbId is not int tmdbId || movie.Cast.Count > 0) return;
        var cast = await TmdbService.FetchCastAsync(tmdbId);
        await MovieService.SaveCastAsync(movie.Id, cast);
        movie = await MovieService.GetByIdAsync(Id);
    }
}
