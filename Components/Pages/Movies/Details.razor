@page "/movies/{Id:int}"
@inject IMovieService MovieService
@inject ITmdbService TmdbService

<PageTitle>@(movie?.Title ?? "Movie")</PageTitle>

@if (movie is null)
{
    <p>Movie not found.</p>
}
else
{
    <div class="row g-4">
        <div class="col-md-3">
            @if (!string.IsNullOrEmpty(movie.PosterUrl))
            {
                <img src="@movie.PosterUrl" class="img-fluid rounded shadow" alt="@movie.Title poster" />
            }
            else
            {
                <div class="bg-secondary rounded d-flex align-items-center justify-content-center" style="height:300px;color:white;">No poster</div>
            }
        </div>
        <div class="col-md-9">
            <h1>@movie.Title</h1>
            <dl class="row mt-3">
                <dt class="col-sm-3">Year</dt>
                <dd class="col-sm-9">@movie.ReleaseYear</dd>
                <dt class="col-sm-3">Genre</dt>
                <dd class="col-sm-9">@(movie.Genre ?? "—")</dd>
                <dt class="col-sm-3">Director</dt>
                <dd class="col-sm-9">@(movie.Director ?? "—")</dd>
                <dt class="col-sm-3">Rating</dt>
                <dd class="col-sm-9">@movie.Rating.ToString("F1") / 10</dd>
            </dl>
            @if (!string.IsNullOrEmpty(movie.Synopsis))
            {
                <p class="mt-2">@movie.Synopsis</p>
            }

            @if (movie.Cast.Count > 0)
            {
                <div class="mt-3">
                    <div class="d-flex flex-wrap gap-3">
                        @foreach (var member in movie.Cast)
                        {
                            <div class="text-center" style="width:80px;">
                                @if (member.ProfileUrl is not null)
                                {
                                    <img src="@member.ProfileUrl" alt="@member.Name"
                                         style="width:64px;height:64px;object-fit:cover;border-radius:50%;" />
                                }
                                else
                                {
                                    <div class="bg-secondary rounded-circle d-flex align-items-center justify-content-center mx-auto"
                                         style="width:64px;height:64px;color:white;font-size:1.2rem;">
                                        @member.Name[0]
                                    </div>
                                }
                                <small class="d-block mt-1 fw-semibold" style="font-size:0.7rem;line-height:1.2;">@member.Name</small>
                                @if (!string.IsNullOrEmpty(member.Character))
                                {
                                    <small class="text-muted" style="font-size:0.65rem;">@member.Character</small>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="d-flex gap-2 mt-3 align-items-center">
                <a href="/movies" class="btn btn-outline-secondary">Back</a>
                <a href="/movies/@movie.Id/edit" class="btn btn-primary">Edit</a>
                <a href="/movies/@movie.Id/delete" class="btn btn-danger">Delete</a>
                @if (movie.TmdbId is not null && movie.Cast.Count == 0)
                {
                    <form method="post" @formname="load-cast" @onsubmit="LoadCast">
                        <AntiforgeryToken />
                        <button type="submit" class="btn btn-outline-secondary btn-sm">Load cast</button>
                    </form>
                }
            </div>
        </div>
    </div>

    @if (trailerKey is not null)
    {
        <div class="mt-4">
            <h5>Trailer</h5>
            <div class="ratio ratio-16x9" style="max-width:720px;">
                <iframe src="https://www.youtube.com/embed/@trailerKey"
                        title="@movie.Title trailer"
                        allowfullscreen
                        referrerpolicy="strict-origin-when-cross-origin">
                </iframe>
            </div>
        </div>
    }

}

@code {
    [Parameter] public int Id { get; set; }
    private Movie? movie;
    private string? trailerKey;

    protected override async Task OnInitializedAsync()
    {
        movie = await MovieService.GetByIdAsync(Id);
        if (movie?.TmdbId is int tmdbId)
            trailerKey = await TmdbService.GetTrailerKeyAsync(tmdbId);
    }

    private async Task LoadCast()
    {
        if (movie?.TmdbId is not int tmdbId || movie.Cast.Count > 0) return;
        var cast = await TmdbService.FetchCastAsync(tmdbId);
        await MovieService.SaveCastAsync(movie.Id, cast);
        movie = await MovieService.GetByIdAsync(Id);
    }
}
