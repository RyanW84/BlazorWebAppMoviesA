@page "/movies/{Id:int}"
@inject IMovieService MovieService
@inject ITmdbService TmdbService

<PageTitle>@(movie?.Title ?? "Movie")</PageTitle>

@if (movie is null)
{
    <div class="archive-terminal">
        <div class="archive-header">
            <span>SKYNET ARCHIVE // FILE RECORD <span class="record-id">NOT FOUND</span></span>
            <span class="header-status"><span class="status-dot-err">◉</span> ERROR</span>
        </div>
        <div class="archive-body">
            <p class="text-muted">// RECORD NOT FOUND IN DATABASE</p>
        </div>
    </div>
}
else
{
    <div class="archive-terminal">

        <div class="archive-header">
            <span>SKYNET ARCHIVE // FILE RECORD <span class="record-id">#@movie.Id.ToString("D5")</span></span>
            <span class="header-status"><span class="status-dot">◉</span> ACTIVE</span>
        </div>

        <div class="archive-body">
            <div class="row g-4">

                <div class="col-md-3">
                    <div class="poster-frame">
                        @if (!string.IsNullOrEmpty(movie.PosterUrl))
                        {
                            <img src="@movie.PosterUrl" alt="@movie.Title poster" class="poster-img" />
                            @if (movie.TmdbId is not null)
                            {
                                <div class="poster-overlay">TMDB: @movie.TmdbId.Value.ToString("D7")</div>
                            }
                        }
                        else
                        {
                            <div class="poster-placeholder">
                                <span>// NO VISUAL</span>
                                <span>// DATA</span>
                            </div>
                        }
                    </div>
                    @if (movie.IsFavorite)
                    {
                        <div class="classified-badge mt-2">◈ CLASSIFIED</div>
                    }
                </div>

                <div class="col-md-9">
                    <div class="archive-title">@movie.Title</div>

                    <div class="field-grid mt-3">
                        <div class="field-row">
                            <span class="field-label">YEAR</span>
                            <span class="field-dots"></span>
                            <span class="field-value">@movie.ReleaseYear</span>
                        </div>
                        <div class="field-row">
                            <span class="field-label">CLASSIFICATION</span>
                            <span class="field-dots"></span>
                            <span class="field-value">@(movie.Genre ?? "// UNKNOWN")</span>
                        </div>
                        <div class="field-row">
                            <span class="field-label">ARCHITECT</span>
                            <span class="field-dots"></span>
                            <span class="field-value">
                                @if (movie.DirectorTmdbId is not null)
                                {
                                    <a href="/person/@movie.DirectorTmdbId" class="person-link">@(movie.Director ?? "// UNKNOWN")</a>
                                }
                                else
                                {
                                    @(movie.Director ?? "// UNKNOWN")
                                }
                            </span>
                        </div>
                        <div class="field-row">
                            <span class="field-label">RATING</span>
                            <span class="field-dots"></span>
                            <span class="field-value">@movie.Rating.ToString("F1") <span class="rating-max">/ 10</span></span>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(movie.Synopsis))
                    {
                        <div class="synopsis-block mt-3">
                            <div class="synopsis-header">// SYNOPSIS</div>
                            <p class="synopsis-text">@movie.Synopsis</p>
                        </div>
                    }

                    <div class="action-bar">
                        <a href="/movies" class="btn btn-outline-secondary btn-sm">← BACK</a>
                        <a href="/movies/@movie.Id/edit" class="btn btn-primary btn-sm">EDIT RECORD</a>
                        <a href="/movies/@movie.Id/delete" class="btn btn-danger btn-sm">DELETE</a>
                        <form method="post" @formname="toggle-favorite" @onsubmit="ToggleFavorite" class="d-inline">
                            <AntiforgeryToken />
                            <button type="submit" class="btn btn-sm @(movie.IsFavorite ? "btn-danger" : "btn-outline-danger")">
                                ♥ @(movie.IsFavorite ? "CLASSIFIED" : "CLASSIFY")
                            </button>
                        </form>
                    </div>
                </div>

            </div>
        </div>

        @if (movie.Cast.Count > 0)
        {
            <div class="terminal-panel">
                <div class="panel-header">PERSONNEL DATABASE</div>
                <div class="panel-body">
                    <div class="cast-grid">
                        @foreach (var member in movie.Cast)
                        {
                            @if (member.TmdbPersonId is not null)
                            {
                                <a href="/person/@member.TmdbPersonId" class="cast-member text-decoration-none">
                                    @if (member.ProfileUrl is not null)
                                    {
                                        <img src="@member.ProfileUrl" alt="@member.Name" class="cast-avatar" />
                                    }
                                    else
                                    {
                                        <div class="cast-avatar-placeholder">@member.Name[0]</div>
                                    }
                                    <div class="cast-name">@member.Name</div>
                                    @if (!string.IsNullOrEmpty(member.Character))
                                    {
                                        <div class="cast-character">@member.Character</div>
                                    }
                                </a>
                            }
                            else
                            {
                                <div class="cast-member">
                                    @if (member.ProfileUrl is not null)
                                    {
                                        <img src="@member.ProfileUrl" alt="@member.Name" class="cast-avatar" />
                                    }
                                    else
                                    {
                                        <div class="cast-avatar-placeholder">@member.Name[0]</div>
                                    }
                                    <div class="cast-name">@member.Name</div>
                                    @if (!string.IsNullOrEmpty(member.Character))
                                    {
                                        <div class="cast-character">@member.Character</div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }

        @if (watchProviders is not null && (watchProviders.Flatrate.Count > 0 || watchProviders.Rent.Count > 0 || watchProviders.Buy.Count > 0))
        {
            <div class="terminal-panel">
                <div class="panel-header">DISTRIBUTION NETWORK</div>
                <div class="panel-body">
                    @if (watchProviders.Flatrate.Count > 0)
                    {
                        <div class="provider-row">
                            <span class="provider-label">STREAM</span>
                            <div class="provider-logos">
                                @foreach (var p in watchProviders.Flatrate.OrderBy(p => p.DisplayPriority).Take(8))
                                {
                                    <img src="@(p.LogoPath != null ? $"https://image.tmdb.org/t/p/w45{p.LogoPath}" : "")"
                                         alt="@p.Name" title="@p.Name" class="provider-logo" />
                                }
                            </div>
                        </div>
                    }
                    @if (watchProviders.Rent.Count > 0)
                    {
                        <div class="provider-row">
                            <span class="provider-label">RENT</span>
                            <div class="provider-logos">
                                @foreach (var p in watchProviders.Rent.OrderBy(p => p.DisplayPriority).Take(8))
                                {
                                    <img src="@(p.LogoPath != null ? $"https://image.tmdb.org/t/p/w45{p.LogoPath}" : "")"
                                         alt="@p.Name" title="@p.Name" class="provider-logo" />
                                }
                            </div>
                        </div>
                    }
                    @if (watchProviders.Buy.Count > 0)
                    {
                        <div class="provider-row">
                            <span class="provider-label">BUY</span>
                            <div class="provider-logos">
                                @foreach (var p in watchProviders.Buy.OrderBy(p => p.DisplayPriority).Take(8))
                                {
                                    <img src="@(p.LogoPath != null ? $"https://image.tmdb.org/t/p/w45{p.LogoPath}" : "")"
                                         alt="@p.Name" title="@p.Name" class="provider-logo" />
                                }
                            </div>
                        </div>
                    }
                    @if (watchProviders.Link is not null)
                    {
                        <div class="mt-2">
                            <small><a href="@watchProviders.Link" target="_blank" rel="noopener noreferrer" class="text-muted">// FULL AVAILABILITY ON JUSTWATCH</a></small>
                        </div>
                    }
                </div>
            </div>
        }

        @if (trailerKey is not null)
        {
            <div class="terminal-panel">
                <div class="panel-header">VISUAL RECORD</div>
                <div class="panel-body">
                    <div class="ratio ratio-16x9 trailer-frame">
                        <iframe src="https://www.youtube.com/embed/@trailerKey"
                                title="@movie.Title trailer"
                                allowfullscreen
                                referrerpolicy="strict-origin-when-cross-origin">
                        </iframe>
                    </div>
                </div>
            </div>
        }

        @if (recommendations.Count > 0)
        {
            <div class="terminal-panel">
                <div class="panel-header">RELATED FILES</div>
                <div class="panel-body">
                    <div class="rec-strip">
                        @foreach (var rec in recommendations)
                        {
                            var recYear = rec.ReleaseDate?.Split('-')[0];
                            var posterSrc = rec.PosterPath != null
                                ? $"https://image.tmdb.org/t/p/w154{rec.PosterPath}"
                                : null;

                            @if (recommendationLocalIds.TryGetValue(rec.Id, out var localId))
                            {
                                <a href="/movies/@localId" class="rec-card text-decoration-none">
                                    @if (posterSrc is not null)
                                    {
                                        <img src="@posterSrc" alt="@rec.Title" class="rec-poster" />
                                    }
                                    else
                                    {
                                        <div class="rec-poster-placeholder">@rec.Title</div>
                                    }
                                    <div class="rec-title">@rec.Title</div>
                                    @if (recYear is not null)
                                    {
                                        <div class="rec-year">@recYear</div>
                                    }
                                </a>
                            }
                            else
                            {
                                <div class="rec-card rec-card--unlinked">
                                    @if (posterSrc is not null)
                                    {
                                        <img src="@posterSrc" alt="@rec.Title" class="rec-poster" />
                                    }
                                    else
                                    {
                                        <div class="rec-poster-placeholder">@rec.Title</div>
                                    }
                                    <div class="rec-title">@rec.Title</div>
                                    @if (recYear is not null)
                                    {
                                        <div class="rec-year">@recYear</div>
                                    }
                                </div>
                            }
                        }
                    </div>
                </div>
            </div>
        }

    </div>
}

@code {
    [Parameter] public int Id { get; set; }
    private Movie? movie;
    private string? trailerKey;
    private TmdbWatchRegion? watchProviders;
    private List<TmdbMovieResult> recommendations = [];
    private Dictionary<int, int> recommendationLocalIds = [];

    protected override async Task OnInitializedAsync()
    {
        movie = await MovieService.GetByIdAsync(Id);
        if (movie?.TmdbId is int tmdbId)
        {
            var trailerTask = TmdbService.GetTrailerKeyAsync(tmdbId);
            var providersTask = TmdbService.GetWatchProvidersAsync(tmdbId);
            var recsTask = TmdbService.GetRecommendationsAsync(tmdbId);

            // Fetch credits if cast is missing, cast lacks person IDs, or director ID is missing
            bool needsCredits = movie.Cast.Count == 0
                || movie.Cast.Any(c => c.TmdbPersonId is null)
                || (movie.DirectorTmdbId is null && !string.IsNullOrEmpty(movie.Director));

            Task<(List<CastMember> Cast, int? DirectorTmdbId)>? creditsTask = needsCredits
                ? TmdbService.FetchCreditsAsync(tmdbId)
                : null;

            var tasks = new List<Task> { trailerTask, providersTask, recsTask };
            if (creditsTask is not null) tasks.Add(creditsTask);
            await Task.WhenAll(tasks);

            trailerKey = trailerTask.Result;
            watchProviders = providersTask.Result;
            recommendations = recsTask.Result;

            if (creditsTask is not null)
            {
                var (fetchedCast, directorTmdbId) = creditsTask.Result;
                await MovieService.BackfillPersonIdsAsync(movie.Id, directorTmdbId, fetchedCast);
                movie = await MovieService.GetByIdAsync(Id);
            }

            if (recommendations.Count > 0)
            {
                var tmdbIds = recommendations.Select(r => r.Id).ToList();
                recommendationLocalIds = await MovieService.GetLocalIdsByTmdbIdsAsync(tmdbIds);

                var toImport = recommendations
                    .Where(r => !recommendationLocalIds.ContainsKey(r.Id))
                    .ToList();

                if (toImport.Count > 0)
                {
                    var fetched = await Task.WhenAll(toImport.Select(r => TmdbService.ImportAsync(r.Id)));
                    foreach (var imported in fetched.OfType<Movie>())
                        await MovieService.AddIfNotExistsAsync(imported);
                    recommendationLocalIds = await MovieService.GetLocalIdsByTmdbIdsAsync(tmdbIds);
                }
            }
        }
    }

    private async Task ToggleFavorite()
    {
        if (movie is null) return;
        await MovieService.ToggleFavoriteAsync(movie.Id);
        movie.IsFavorite = !movie.IsFavorite;
    }
}
